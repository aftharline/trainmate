<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hasIO = 'IntersectionObserver' in window;
  // reveal-on-scroll: otomatis untuk kartu & modul (tanpa edit HTML per elemen)
  var els = document.querySelectorAll('.card,.step,.price,.mini,#faq details,.trans,.final-box,.chart,.frame,.fact,.sstep');
  els.forEach(function(el){ el.classList.add('rv'); });
  if(!reduce && hasIO){
    var io = new IntersectionObserver(function(es){
      es.forEach(function(e,i){ if(e.isIntersecting){ var t = e.target; t.style.transitionDelay = ((Array.prototype.indexOf.call(t.parentNode.children, t) % 3) * 90) + 'ms'; t.classList.add('on'); io.unobserve(t); setTimeout(function(){ t.style.transitionDelay = ''; }, 800); } });
    },{threshold:.12,rootMargin:'0px 0px -8% 0px'});
    els.forEach(function(el){ io.observe(el); });
    // scrollytelling: langkah aktif menggerakkan visual sticky
    var fig = document.querySelector('.story-visual');
    var steps = document.querySelectorAll('.sstep');
    if(fig && steps.length){
      var so = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ fig.setAttribute('data-active', e.target.getAttribute('data-s')); } });
      },{rootMargin:'-45% 0px -45% 0px'});
      steps.forEach(function(s){ so.observe(s); });
    }
    // chart menggambar sendiri saat terlihat
    var line = document.querySelector('.draw-line');
    if(line){
      var co = new IntersectionObserver(function(es){
        es.forEach(function(e){ if(e.isIntersecting){ line.classList.add('drawn'); co.disconnect(); } });
      },{threshold:.4});
      co.observe(line);
    }
  } else {
    els.forEach(function(el){ el.classList.add('on'); });
    var l = document.querySelector('.draw-line'); if(l){ l.classList.add('drawn'); }
  }
})();
</script>
